# Base URL of the AURUM AI FastAPI backend (no trailing slash). On Vercel use /api/v1 (see DEPLOY_VERCEL.md).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# true  = use the clearly-labelled DEMO DATA layer (src/mocks) for market/COT previews
# false = request every dataset from the backend
# Users can also toggle this at runtime under Settings → Data.
VITE_ENABLE_MOCK_DATA=true

# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=10000

# Server-Sent Events stream for real-time quotes. Empty = the backend's own stream
# (<VITE_API_BASE_URL>/market/stream/quotes); "off" disables streaming.
VITE_REALTIME_URL=

# Name shown in the "Built by" credit (sidebar and Settings → About)
VITE_BUILT_BY=

# NEVER put broker passwords, database credentials or API secrets in VITE_* variables:
# every VITE_* value is compiled into the public JavaScript bundle.
