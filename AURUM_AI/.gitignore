# secrets
.env
# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
# runtime data (keep folder skeleton)
data/raw/*
data/processed/*
data/exports/*
!data/**/.gitkeep
data/*.db
# local backups of superseded collections (never commit)
data/_superseded*/
# collector on/off switch (local only)
COLLECTOR_DISABLED
logs/*
!logs/.gitkeep
