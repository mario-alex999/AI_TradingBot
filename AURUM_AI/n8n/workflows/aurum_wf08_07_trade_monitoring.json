      "position": [
        220,
        300
      ],
      "notes": "The only place the AURUM API address and the two tokens are set. Every request in this workflow goes only to this address."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $('AURUM trigger (schedule or trade event)').first().json.headers['x-aurum-webhook-token'] || '' }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "={{ $json.webhookToken }}"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "978fb509-e232-4670-a008-0258464c019d",
