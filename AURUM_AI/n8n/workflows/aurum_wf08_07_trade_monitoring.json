              "name": "aurumApi",
              "value": "https://aurum-api-tan.vercel.app/api/v1/orchestration",
              "type": "string"
            },
            {
              "id": "aurum-service-token",
              "name": "serviceToken",
              "value": "REPLACE_WITH_AURUM_SERVICE_TOKEN",
              "type": "string"
            },
            {
              "id": "aurum-webhook-token",
              "name": "webhookToken",
              "value": "REPLACE_WITH_AURUM_WEBHOOK_TOKEN",
              "type": "string"
