      "typeVersion": 2.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ accepted: false, error: 'invalid webhook token' }) }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "f9345ed3-ee41-4bd5-a694-b1e42a94a154",
      "name": "Reject (wrong webhook token)",
