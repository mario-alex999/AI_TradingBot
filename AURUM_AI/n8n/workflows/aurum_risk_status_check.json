{
  "id": "aurumRiskStatus01",
  "name": "AURUM - Risk status check (read-only)",
  "active": false,
  "nodes": [
    {
      "id": "c2a1d8b3-0002-4b9f-8e21-000000000001",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 15 }] } }
    },
    {
      "id": "c2a1d8b3-0002-4b9f-8e21-000000000002",
      "name": "GET /risk/account",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "parameters": { "method": "GET", "url": "http://host.docker.internal:8000/api/v1/risk/account", "options": { "timeout": 20000 } }
    },
    {
      "id": "c2a1d8b3-0002-4b9f-8e21-000000000003",
      "name": "Not within limits?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            { "id": "s1", "leftValue": "={{ $json.overallStatus }}", "rightValue": "WITHIN_LIMITS",
              "operator": { "type": "string", "operation": "notEquals" } }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "c2a1d8b3-0002-4b9f-8e21-000000000004",
      "name": "Alert (connect your notifier here)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [720, -80],
      "parameters": {}
    }
  ],
  "connections": {
    "Every 15 minutes": { "main": [[{ "node": "GET /risk/account", "type": "main", "index": 0 }]] },
    "GET /risk/account": { "main": [[{ "node": "Not within limits?", "type": "main", "index": 0 }]] },
    "Not within limits?": { "main": [[{ "node": "Alert (connect your notifier here)", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
