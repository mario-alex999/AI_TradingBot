# =====================================================================
# AURUM AI - Module 01 configuration.
# Copy to ".env" and fill in your values. NEVER commit the real .env file.
# =====================================================================

# ---- MetaTrader 5 ---------------------------------------------------
# Full path to terminal64.exe. Leave empty to use the terminal that is already running.
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# Optional: leave the three values below empty to use the account already logged in to the terminal.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT_MS=60000
# Time zone of the broker's SERVER clock (MT5 returns candle times in server time).
# Use an IANA name, e.g. Europe/Athens (common "GMT+2/+3 New York close" brokers), Etc/UTC, Europe/London.
# "auto" estimates a fixed offset from the latest tick (only reliable while the market is open; ignores DST).
MT5_SERVER_TIMEZONE=Europe/Athens

# ---- Database (PostgreSQL / TimescaleDB) ----------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aurum
DB_USER=aurum
DB_PASSWORD=change_me
# Optional full SQLAlchemy URL; overrides the DB_* values above.
# Example quick-start without PostgreSQL:  DATABASE_URL=sqlite:///data/aurum.db
DATABASE_URL=

# ---- Collection -----------------------------------------------------
COLLECTION_INTERVAL_SECONDS=300
HISTORICAL_CANDLE_COUNT=500
ENABLED_INSTRUMENTS=EURUSD,GBPUSD,XAUUSD,US30
ENABLED_TIMEFRAMES=D1,H4,H1,M15,M5
EXCLUDE_FORMING_CANDLE=true
# A candle-to-candle jump larger than this multiple of the median candle range is flagged as "abnormal_gap".
GAP_RANGE_MULTIPLE=8.0

# ---- Paths & logging ------------------------------------------------
INSTRUMENTS_CONFIG=config/instruments.yaml
DATA_DIR=data
LOG_DIR=logs
LOG_LEVEL=INFO

# ---- Module 02: COT engine + backend API ----------------------------
# Optional Socrata app token for publicreporting.cftc.gov (higher rate limits). Never commit a real token.
CFTC_APP_TOKEN=
# Enables admin API operations (POST /api/v1/cot/backfill|update|calculate). Empty = disabled.
# Use a long random value; clients send it in the X-AURUM-Admin-Key header.
AURUM_ADMIN_API_KEY=
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated browser origins allowed to call the API (the Vite dev server by default)
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Optional AI review (advisory only; it never places trades) ------
# Off by default. To turn it on, set all three: AI_REVIEW_ENABLED=true, ANTHROPIC_API_KEY and a monthly budget in USD.
# The budget is a hard stop: a review runs only if its worst-case cost fits in what is left this month.
AI_REVIEW_ENABLED=false
ANTHROPIC_API_KEY=
AI_REVIEW_MONTHLY_BUDGET_USD=
# Optional: claude-opus-5-5 (default), claude-sonnet-5-5 or claude-haiku-5-5
AI_REVIEW_MODEL=claude-opus-5-5
AI_REVIEW_EFFORT=high
AI_REVIEW_MAX_TOKENS=8000
AI_REVIEW_TIMEOUT_SECONDS=300
# Module 05 candidate reviews share the budget above and are also limited per hour.
AI_REVIEW_MAX_CALLS_PER_HOUR=20
# anthropic (default), openai or local. The monthly budget can only cap anthropic: the others rely on the hourly limit.
AI_PROVIDER=anthropic
AI_PROVIDER_MODEL=
AI_PROVIDER_BASE_URL=
OPENAI_API_KEY=

# ---- Module 05: decision engine (candidates for human review; it never places trades) ----
DECISION_LOOP_INTERVAL_SECONDS=300


# Legacy risk monitoring for /risk/overview (optional, percent of equity). Monitored only. The enforcing engine is
# Module 06 (config/risk.yaml, versioned in the database). AURUM places no orders. Leave blank to disable.
RISK_MAX_PER_TRADE_PCT=
RISK_MAX_DAILY_LOSS_PCT=
RISK_MAX_OPEN_POSITIONS=
RISK_MAX_TOTAL_EXPOSURE_PCT=
RISK_MAX_CORRELATED_EXPOSURE_PCT=

# ---- n8n automation (docker-compose.n8n.yml) ------------------------
# Encrypts the credentials n8n stores. Generate once (python -c "import secrets;print(secrets.token_hex(32))") and keep it:
# losing it makes saved n8n credentials unreadable.
N8N_ENCRYPTION_KEY=
N8N_PORT=5678
N8N_TIMEZONE=UTC

# ---- Module 06: risk engine (decides and sizes; it never places trades) ----
# Default webhook for `python -m aurum.cli risk events dispatch` (e.g. the n8n receiver below). Empty = pull only
# via GET /api/v1/risk/events.
RISK_EVENTS_WEBHOOK_URL=
# n8n example: RISK_EVENTS_WEBHOOK_URL=http://localhost:5678/webhook/aurum-risk-events

# ---- Module 07: human approval and trade management (it never places trades) ----
# Sign-in. Create the first administrator with: python -m aurum.cli users create <name> --role admin
# (the password is asked for, hidden; it is never an argument or an environment variable).
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_ABSOLUTE_HOURS=12
# true behind HTTPS (production). false only for http://localhost development.
AUTH_COOKIE_SECURE=false
AUTH_PASSWORD_ITERATIONS=600000
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
# Seed policy (copied into the database as policy v1 on first use; later changes go through the API, versioned).
APPROVALS_CONFIG=config/approvals.yaml
APPROVALS_WORKER_INTERVAL_SECONDS=15
# Where `approvals worker` POSTs outbox events (e.g. n8n). Empty = consumers poll GET /api/v1/approvals/events.
APPROVALS_EVENTS_WEBHOOK_URL=
# n8n example: APPROVALS_EVENTS_WEBHOOK_URL=http://localhost:5678/webhook/aurum-approval-events
# Optional email notifications (also enable "email" in the approval policy's notification channels).
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# Optional Telegram notifications (informational only: Telegram can never approve).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Module 08: workflow orchestration (n8n integration core; it never approves or executes trades) ----
# One environment per database: development | test | demo | production. The database is pinned to the first value used.
ORCHESTRATION_ENVIRONMENT=demo
ORCHESTRATION_WORKER_INTERVAL_SECONDS=10
# Where n8n posts callbacks (sent to n8n in every request; the shipped test workflow uses a fixed URL instead).
ORCHESTRATION_CALLBACK_BASE_URL=http://host.docker.internal:8000/api/v1/orchestration
# Module 08 -> other AURUM modules (health checks, read-only Module 07 approval lookups).
AURUM_INTERNAL_BASE_URL=http://127.0.0.1:8000/api/v1
# Bearer token Module 08 uses for module endpoints that need one (Module 07). Create with:
#   python -m aurum.cli users token-create aurum-module08 --scope approvals:view
ORCHESTRATION_SERVICE_TOKEN=
N8N_BASE_URL=http://localhost:5678
N8N_PUBLIC_URL=
N8N_WEBHOOK_BASE_URL=
N8N_ENVIRONMENT=
# n8n public API key (n8n UI > Settings > n8n API). Without it triggering still works, but execution status,
# reconciliation, activation sync and stop are unavailable and n8n shows as DEGRADED.
N8N_API_KEY=
# Sent to n8n as X-AURUM-Webhook-Token; store the same value in n8n as a Header Auth credential on the trigger webhook.
N8N_WEBHOOK_AUTH_TOKEN=
# HMAC-SHA256 signing secret (X-Aurum-Signature on requests to n8n and outbound event webhooks). Generate with
#   python -c "import secrets;print(secrets.token_urlsafe(32))"   Rotate: move the old value to ..._PREVIOUS first.
N8N_WEBHOOK_SHARED_SECRET=
N8N_WEBHOOK_SHARED_SECRET_PREVIOUS=
N8N_REQUEST_TIMEOUT=10
N8N_RETRY_LIMIT=5
